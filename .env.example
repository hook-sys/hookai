# Supabase: Project Settings -> API থেকে নিয়ে .env.local ফাইলে বসাও
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# লোকাল ডেভেলপমেন্টের জন্য
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta Marketing API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
# openssl rand -hex 32 দিয়ে তৈরি করো (64 অক্ষর)
META_TOKEN_ENCRYPTION_KEY=your-64-char-hex-key

# Privacy, Terms ও Data deletion পেজে যোগাযোগের ইমেইল (না দিলে ইমেইল দেখাবে না)
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
